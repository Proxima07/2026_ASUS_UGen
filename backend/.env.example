# 模型網址是 API 前綴，程式會加上 /chat/completions。
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=your-local-model
LLM_API_KEY=local-unused
LLM_OUTPUT_MODE=json_object
LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0
LLM_CA_BUNDLE=
LLM_ALLOW_NONLOCAL=false

# 留空即不啟用轉錄；有既有本地 OpenAI 相容 STT endpoint 才填。
STT_BASE_URL=
STT_MODEL=whisper-1
STT_API_KEY=
STT_TIMEOUT_SECONDS=120
STT_CA_BUNDLE=
STT_ALLOW_NONLOCAL=false

# 必須改為你的 Cloudflare Tunnel HTTPS 網站來源。
PUBLIC_BASE_URL=https://assistant.example.com
# python -c "import secrets; print(secrets.token_urlsafe(48))" 產生後填入。
ADMIN_BOOTSTRAP_TOKEN=CHANGE_TO_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
# 舊版設定只保留相容；新配對不再共用此身分。
# 每個配對碼預設建立獨立使用者。需要指定身分時由管理者使用 --user-id。
DEFAULT_USER_ID=poc-user
DATA_DIR=runtime
WEB_DIR=../web
TIMEZONE=Asia/Taipei
PORT=8000
SESSION_TTL_SECONDS=3600
ACTION_TTL_SECONDS=300
ACTION_LEASE_SECONDS=600
MAX_TEXT_CHARS=8000
MAX_AUDIO_BYTES=10485760
MAX_AUDIO_JOBS=2
ENABLE_API_DOCS=false
# 操作階段JSON日誌輸出到終端；不開啟包含query/header的HTTP access log。
LOG_LEVEL=INFO
# true 才顯示最多200字的指令/逐字稿；false僅記字數與狀態。
LOG_COMMAND_TEXT=false
# 多輪只將後端已保存的有限歷史送給本地模型；最多20輪儲存映射。
CONVERSATION_MAX_MESSAGES=12
CONVERSATION_MAX_CHARS=16000
