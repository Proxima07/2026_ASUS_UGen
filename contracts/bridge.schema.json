          "maxLength": 64,
          "minLength": 1,
          "title": "State",
          "type": "string"
        },
        "message": {
          "default": "",
          "maxLength": 3000,
          "title": "Message",
          "type": "string"
        },
        "result": {
          "additionalProperties": true,
          "title": "Result",
          "type": "object"
        }
